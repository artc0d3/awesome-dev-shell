{
  "extends": "nolabs-ai/claude",
  "meta": {
    "name": "yolo-claude"
  },
  "environment": {
    "set_vars": {
      "DOCKER_CONFIG": "$HOME/.cache/docker-sandbox",
      "GIT_CONFIG_COUNT": "2",
      "GIT_CONFIG_KEY_0": "commit.gpgsign",
      "GIT_CONFIG_VALUE_0": "false",
      "GIT_CONFIG_KEY_1": "tag.gpgsign",
      "GIT_CONFIG_VALUE_1": "false"
    }
  },
  "filesystem": {
    "allow": [
      "$WORKDIR",
      "~/.cache/mise",
      "~/.gradle/caches",
      "~/.gradle/wrapper",
      "~/.gradle/daemon",
      "~/.gradle/native",
      "~/.gradle/.tmp",
      "~/.npm",
      {
        "path": "~/Library/Application Support/rtk",
        "when": "macos"
      },
      {
        "path": "~/.local/share/rtk",
        "when": "linux"
      }
    ],
    "read": [
      "~/.colima/default",
      "~/.gradle",
      "~/.npm-global",
      "~/.local/share/mise",
      "~/.local/state/mise"
    ],
    "deny": [
      "$NONO_CONFIG/profiles/yolo-claude.json"
    ],
    "suppress_save_prompt": [
      "/"
    ]
  },
  "open_urls": {
    "allow_localhost": true,
    "allow_origins": [
      "https://claude.ai",
      "https://claude.com",
      "https://api.anthropic.com",
      "https://platform.claude.com",
      "https://github.com"
    ]
  }
}
