{
  "extends": "always-further/claude",
  "meta": {
    "name": "yolo-claude"
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": [
      "/tmp",
      "~/.docker",
      "~/.cache/mise",
      "~/.local/state/mise",
      "~/.local/share/mise",
      "~/.gradle",
      "~/.npm"
    ],
    "read_file": [
      "~/.ssh/signing-key.pub",
      "~/.gitconfig",
      "/etc/passwd"
    ],
    "bypass_protection": [
      "~/.ssh/signing-key.pub"
    ]
  }
}
