{
  "extends": "nolabs-ai/claude",
  "meta": {
    "name": "yolo-claude"
  },
  "environment": {
    "set_vars": {
      "DOCKER_CONFIG": "$HOME/.cache/docker-sandbox"
    }
  },
  "filesystem": {
    "allow": [
      "$WORKDIR",
      "~/.cache/mise",
      "~/.gradle/caches",
      "~/.gradle/wrapper",
      "~/.gradle/daemon",
      "~/.gradle/native",
      "~/.gradle/.tmp",
      "~/.npm",
      { "path": "~/Library/Application Support/rtk", "when": "macos" },
      { "path": "~/.local/share/rtk", "when": "linux" }
    ],
    "read": [
      "~/.npm-global",
      "~/.local/share/mise",
      "~/.local/state/mise"
    ],
    "read_file": [
      "~/.ssh/signing-key.pub"
    ],
    "bypass_protection": [
      "~/.ssh/signing-key.pub"
    ],
    "deny": [
      "$NONO_CONFIG/profiles/yolo-claude.json"
    ],
    "suppress_save_prompt": [
      "/"
    ]
  },
  "open_urls": {
    "allow_localhost": true,
    "allow_origins": [
      "https://claude.ai",
      "https://claude.com",
      "https://api.anthropic.com",
      "https://platform.claude.com",
      "https://github.com"
    ]
  }
}
