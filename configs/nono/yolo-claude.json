{
  "extends": "always-further/claude",
  "meta": {
    "name": "yolo-claude"
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": [
      "~/.cache/mise",
      "~/.local/state/mise",
      "~/.local/share/mise"
    ]
  },
  "environment": {
    "set_vars": {
      "TMPDIR": "/tmp/claude-1000"
    }
  }
}
