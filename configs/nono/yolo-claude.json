{
  "extends": "always-further/claude",
  "meta": {
    "name": "yolo-claude"
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": [
      "/tmp",
      "~/.docker",
      "~/.cache/mise",
      "~/.local/state/mise",
      "~/.local/share/mise",
      "~/.gradle",
      "~/.npm",
      "~/Library/Application Support/rtk"
    ],
    "read": [
      "~/.npm-global"
    ],
    "read_file": [
      "~/.ssh/signing-key.pub",
      "~/.gitconfig",
      "/etc/passwd"
    ],
    "bypass_protection": [
      "~/.ssh/signing-key.pub"
    ]
  },
  "open_urls": {
    "allow_localhost": true,
    "allow_origins": [
      "https://github.com"
    ]
  }
}
